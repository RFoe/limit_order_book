# build outputs (never commit binaries; -march=native artifacts must be rebuilt per machine)
build/
.cache/

# workloads / market data: regenerated by scripts/gen_workloads.sh, scripts/fetch_itch.sh
data/
*.ops
*.gz

# raw profiler outputs (text summaries in results/ are committed)
perf.data*
*.zst
results/**/*.perf.data*
